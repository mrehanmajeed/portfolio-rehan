# Resend API key for the contact form — https://resend.com/api-keys
# Without it the endpoint returns 503 and logs the reason instead of failing silently.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional. Defaults to Resend's shared sender, which needs no domain
# verification but can only deliver to the Resend account's own address.
# Set this once you verify a custom domain.
# CONTACT_FROM_EMAIL=Portfolio <hello@yourdomain.com>

# Optional. Defaults to the address published on the site.
# CONTACT_TO_EMAIL=you@gmail.com

# Absolute origin of the deployment. Used for metadata, sitemap.xml, robots.txt.
# On Vercel this falls back to the project's production domain automatically.
NEXT_PUBLIC_SITE_URL=https://rehanmajeed.vercel.app
